# Окружение демо-стенда (deploy/compose.demo.yml). Копия — deploy/.env.demo,
# в git не попадает.
#
# Секреты — СВОИ, не боевые: токен, выданный демо, не должен открывать
# ant-yenisey.ru. Сгенерировать: openssl rand -base64 48

# Полный адрес демо, без https:// — от него WEB_ORIGIN и CORS.
DOMAIN=demo.ant-yenisey.ru

# Имя базы ОБЯЗАНО содержать «demo»: иначе demo-world откажется в неё писать.
POSTGRES_DB=yenisey_demo
POSTGRES_USER=yenisey_demo
POSTGRES_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Пароль демо-учёток owner@, director@, manager@, admin@, coach@, player@,
# parent@, child@ на knt.test — тот, что называют заказчику. Не короче 8.
DEMO_PASSWORD=

# Можно взять боевой ключ: без него в настройках не поправить зал (адрес
# проверяется справочником). Остальные внешние службы на демо выключены.
DADATA_API_KEY=
