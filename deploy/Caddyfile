# Обратный прокси «Енисея».
#
# Caddy, а не nginx, по одной причине: сертификат он получает и продлевает сам,
# без certbot, cron и отдельного тома для ACME-проверки. Один домен, одна
# машина — тот случай, когда автоматика надёжнее ручной настройки.

{
	email {$TLS_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# API и веб живут за одним доменом намеренно. Кросс-доменных запросов
	# тогда нет вовсе: CORS не нужен, а кука обновления сессии становится
	# первой стороной — браузеры к межсайтовым кукам относятся всё строже,
	# и на этом ломается именно вход, причём не у всех и не сразу.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	# Заголовки, которые дешевле поставить сразу, чем объяснять потом.
	header {
		# Страницу нельзя встроить в чужой iframe: так крадут нажатия.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# HSTS на год. Включается ПОСЛЕ того, как сайт заведомо открывается по
		# https: браузер запомнит запрет ходить по http и на ошибку в
		# сертификате ответит наглухо закрытой страницей.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
