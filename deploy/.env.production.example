# Боевые переменные «Енисея». Копируется на сервере в deploy/.env и
# заполняется там же — в git этот файл не попадает и попасть не должен.
#
#   cp deploy/.env.production.example deploy/.env
#   chmod 600 deploy/.env
#
# Секреты генерировать НА СЕРВЕРЕ и нигде больше:
#   openssl rand -base64 48

# --- Домен ------------------------------------------------------------------
# Без протокола и без завершающего слэша: «club.example.ru».
DOMAIN=
# Почта для Let's Encrypt — на неё придёт письмо, если автопродление сломается.
TLS_EMAIL=

# --- База -------------------------------------------------------------------
# Пользователь и база создаются самим контейнером Postgres при первом запуске.
# Менять их потом бессмысленно: том уже создан с этими значениями.
POSTGRES_DB=yenisey
POSTGRES_USER=yenisey
POSTGRES_PASSWORD=

# --- Токены -----------------------------------------------------------------
# ОБЯЗАТЕЛЬНО разные: при совпадении refresh-токен принимается как access и
# обходит короткий срок жизни. API проверяет это на старте и падает сразу.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Прочее -----------------------------------------------------------------
# Пусто — CORS разрешён только своему домену (см. compose.yml). Заполняется,
# когда появится мобильный клиент на другом источнике.
CORS_ORIGINS=

AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_ATTEMPT_WINDOW=15m
RATE_LIMIT=120
RATE_LIMIT_WINDOW=1m

# Джоба автонеявки: на боевой базе включена. Выключать её стоит только на
# время разбора инцидента — пока она молчит, неотмеченные записи копятся.
ATTENDANCE_JOB=on
ATTENDANCE_JOB_INTERVAL=5m
