# --- База данных -----------------------------------------------------------
# Локальная разработка: PostgreSQL 18, установленный нативно.
DATABASE_URL="postgresql://postgres:ваш-пароль@127.0.0.1:5432/yenisey_dev?schema=public"

# Отдельная одноразовая база под прогон схемы (docs/verify-schema.sh).
# Никогда не направлять на боевую БД — скрипт пишет туда заведомо битые данные.
SHADOW_DATABASE_URL="postgresql://postgres:ваш-пароль@127.0.0.1:5432/yenisey_shadow?schema=public"

# --- Авторизация -----------------------------------------------------------
# Секреты access- и refresh-токенов ОБЯЗАТЕЛЬНО разные: одинаковые позволяют
# предъявить refresh-токен как access и обойти срок жизни короткого токена.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="замени-на-случайную-строку-не-короче-32-символов"
JWT_REFRESH_SECRET="замени-на-другую-случайную-строку-не-короче-32-символов"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- API -------------------------------------------------------------------
API_PORT=3001
# Через запятую: источники, которым разрешён CORS к API.
CORS_ORIGINS="http://localhost:3000"

# --- Ограничение частоты ---------------------------------------------------
# Подбор пароля: сколько неудачных попыток входа подряд допускается для одной
# учётки и за какое время счётчик забывается. Считаются ТОЛЬКО провалы, ключ —
# «клуб + адрес почты», а не IP: адрес меняется ботнетом бесплатно, а весь зал
# клуба сидит за одним.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_ATTEMPT_WINDOW="15m"

# Грубый лимит на весь API — защита от заваливания запросами. Вне production не
# применяется к запросам с петлевого адреса, иначе в него упирался бы pnpm smoke.
RATE_LIMIT=120
RATE_LIMIT_WINDOW="1m"

# --- Отметка присутствия ---------------------------------------------------
# Джоба автонеявки: запись, которую клуб не отметил за сутки после окончания
# (настройка клуба), становится неявкой со списанием по его политике.
# on / off; не задано — включена в production и выключена в разработке, чтобы
# dev-сервер не ставил неявки демо-данным.
# ATTENDANCE_JOB=off
# Как часто джоба просыпается. Неявку она ставит не раньше срока клуба, так что
# интервал влияет только на то, насколько позже срока это случится.
ATTENDANCE_JOB_INTERVAL="5m"

# --- Уведомления в MAX -----------------------------------------------------
# Без токена в разработке работает поддельный MAX: сообщения копятся в памяти
# API, смотреть — GET /api/dev/max/sent?maxUserId=… Настоящий бот — токен и
# адрес из настроек бота на business.max.ru плюс NOTIFICATIONS_JOB=on; события
# он тогда опрашивает сам (вебхук нужен только на стенде с https).
# MAX_BOT_TOKEN=
# MAX_BOT_LINK="https://max.ru/yenisey_bot"
# MAX_WEBHOOK_SECRET=
# NOTIFICATIONS_JOB=off
NOTIFICATIONS_JOB_INTERVAL="10s"
# Уведомления в браузер: npx web-push generate-vapid-keys. Без ключей — пара на
# время запуска и поддельный транспорт (GET /api/dev/push/sent?endpoint=…).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"
# Пояс утренней сводки владельцу платформы.
# PLATFORM_TIMEZONE="Asia/Krasnoyarsk"

# --- Адреса залов -----------------------------------------------------------
# Подсказки адреса зала — DaData (личный кабинет dadata.ru → «API-ключ»),
# бесплатно до 10 000 запросов в сутки. Без ключа в разработке работает
# поддельный справочник на несколько домов Красноярска, Абакана и Минусинска;
# в production без ключа зал с новым адресом не сохранить.
# DADATA_API_KEY=

# --- Frontend --------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
