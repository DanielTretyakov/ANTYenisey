{
  "name": "@yenisey/database",
  "version": "0.1.0",
  "private": true,
  "main": "./generated/client/index.js",
  "types": "./generated/client/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "verify": "bash scripts/verify-schema.sh",
    "typecheck": "tsc --noEmit",
    "seed": "dotenv -e ../../.env -- node --experimental-strip-types prisma/seed.ts",
    "clean-probes": "dotenv -e ../../.env -- node --experimental-strip-types prisma/clean-probes.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "typescript": "^5.7.2",
    "dotenv-cli": "^8.0.0",
    "@types/node": "^22.10.5"
  }
}
