// Prisma-схема платформы «Енисей» (Этап 1).
// Реализует раздел docs/TZ.md → «Модель данных».
//
// Схема развёрнута на PostgreSQL 18 (40 таблиц), ограничения из
// prisma/constraints.sql накатываются миграцией, сценарии
// prisma/tests/schema-tests.sql проходят — включая проверку, что база
// физически не даёт смешать данные двух клубов.
// Прогон против одноразовой базы: pnpm --filter @yenisey/database verify
//
// Проверено на Prisma 6.x. На Prisma 7 схема не валидируется: там `url` из
// блока datasource переехал в prisma.config.ts.
//
// ---------------------------------------------------------------------------
// ДВА СКВОЗНЫХ ПРАВИЛА, БЕЗ КОТОРЫХ СХЕМУ НЕЛЬЗЯ ЧИТАТЬ ПРАВИЛЬНО
// ---------------------------------------------------------------------------
//
// 1. ВСЕ ДЕНЕЖНЫЕ СУММЫ ХРАНЯТСЯ В КОПЕЙКАХ (Int).
//    700 ₽ = 70000. Дробных рублей в БД не существует — округление и
//    форматирование только на границе с ЮKassa и с UI. Причина: float для
//    денег недопустим, а Decimal в JS требует отдельной библиотеки.
//
// 2. ИЗОЛЯЦИЯ КЛУБОВ ДЕРЖИТСЯ НА СОСТАВНЫХ ВНЕШНИХ КЛЮЧАХ.
//    tenantId продублирован во все дочерние таблицы, а связи идут не по
//    одному id, а по паре (id, tenantId). Родители объявляют @@unique([id,
//    tenantId]) — именно на неё ссылается составной FK.
//    Что это даёт: база физически не примет бронь, у которой сессия из
//    клуба А, а клиент из клуба Б. Забытый `where: { tenantId }` больше не
//    превращается в утечку между клубами — целостность гарантирует Postgres,
//    а не аккуратность разработчика.
//
//    Человек в эту схему входит НЕ через User: учётная запись глобальная и
//    клубу не принадлежит (ТЗ → «Платформа и клубы: единый аккаунт»). Точка
//    входа — TenantMembership, пара «человек + клуб»: всё клубное ссылается
//    на неё по (userId, tenantId), и именно она держит роль. Тот же приём,
//    та же гарантия — просто мишень составного ключа на одну таблицу дальше.
//
// 3. УДАЛЕНИЕ ПО УМОЛЧАНИЮ ЗАПРЕЩЕНО (onDelete: Restrict).
//    Почти все связи объявляют Restrict явно, и это осознанный выбор: за
//    каждой строкой здесь стоят деньги или обязательства перед клиентом.
//    Каскадное удаление клиента унесло бы его платежи и историю визитов —
//    ровно то, что требуется для бухгалтерии. Поэтому «удаление» клиента и
//    сотрудника — это deactivatedAt на TenantMembership (ушёл из этого клуба)
//    или deactivatedAt/anonymizedAt на User (ушёл с платформы), а не DELETE.
//    Cascade оставлен только там, где дочерняя строка бессмысленна без
//    родителя и не содержит финансовых следов: профили при удалении учётки,
//    уведомления, настройки клуба.
//    Полагаться на молчаливые дефолты Prisma (Restrict для обязательных,
//    SetNull для необязательных связей) в денежной схеме нельзя: SetNull
//    тихо обнулил бы ссылку на платёж вместо того, чтобы остановить удаление.
//
// Ограничения, которые Prisma не умеет выразить (запрет пересечения броней
// стола, частичные уникальные индексы, check-констрейнты), лежат рядом в
// docs/schema-constraints.sql и накатываются как raw-SQL миграция.

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Теневая база нужна prisma migrate dev: он сверяет с ней состояние
  // миграций. Отдельная база, а не схема внутри рабочей — Prisma её дропает.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Клиент кладём внутрь пакета, а не в node_modules/.prisma: при pnpm с
  // isolated node-linker сгенерированный клиент из node_modules не виден
  // соседним пакетам workspace.
  output   = "../generated/client"
}

// ---------------------------------------------------------------------------
// Enums — справочники допустимых значений полей
// ---------------------------------------------------------------------------

/// Роль пользователя внутри одного клуба (tenant). Один и тот же человек в
/// разных клубах может иметь разные роли — роль хранится на User, а не глобально.
enum Role {
  CLIENT // клиент клуба
  ADMIN // администратор клуба
  COACH // тренер
  OWNER // руководство клуба: те же права, что ADMIN, плюс управление персоналом
}

/// Как появилась запись на тренировку: клиент записался сам через сайт, или
/// администратор добавил её вручную (в т.ч. задним числом).
enum BookingSource {
  ONLINE
  MANUAL
}

/// Единый статус для брони тренировки / турнира / стола.
enum BookingStatus {
  BOOKED // запись активна, оплата холдирована
  CANCELLED // клиент отменил (списание зависит от времени отмены — см. chargeRatio)
  ATTENDED // администратор подтвердил присутствие
  NO_SHOW // клиент не пришёл и не отменил — 100% списание
}

/// Минимальный шаг бронирования стола — клуб выбирает один из вариантов при
/// настройке профиля.
/// Почему стол недоступен для самостоятельной онлайн-брони.
///
/// Администратор выбирает это, закрывая время в сетке. Клиент видит только
/// то, что время занято, — расшифровка нужна персоналу клуба и статистике.
enum ClosurePurpose {
  RENT // аренда, оформленная мимо сайта
  SPARRING // спарринг с тренером
  TRAINING // групповая или индивидуальная тренировка
  ROBOT // занятие с роботом
  TOURNAMENT // турнир клуба
  OTHER // всё остальное: ремонт, техническая уборка, аренда зала целиком
}

enum BookingStep {
  MIN_10
  MIN_15
  MIN_20
  MIN_30
  HOUR_1
}

/// Каким способом клиент заплатил за конкретную бронь/визит.
enum PaymentMethod {
  YOOKASSA // онлайн-оплата картой через ЮKassa (двухстадийно: холд → списание)
  SUBSCRIPTION_BALANCE // списание визита с баланса абонемента
  CASH // наличные — только первый визит незарегистрированного клиента «с порога»
}

/// Статус денег в рамках двухстадийного платежа ЮKassa.
enum PaymentStatus {
  HELD // сумма заморожена (холд) при записи, ещё не списана
  CAPTURED // списана полностью (100% — неявка без отмены)
  PARTIALLY_CAPTURED // списана частично (50% — поздняя отмена)
  REFUNDED // холд снят полностью (0% — ранняя отмена)
  CANCELLED // платёж отменён/не состоялся
}

/// Назначение платежа. Нужно, чтобы отличить оплату разовой услуги от
/// покупки абонемента и от подписки клуба на платформу.
enum PaymentPurpose {
  SERVICE // тренировка / турнир / аренда стола
  SUBSCRIPTION_PURCHASE // клиент купил абонемент
}

/// Статус подписки клуба на платформу.
enum PlatformSubscriptionStatus {
  ACTIVE
  PAST_DUE // просрочен платёж, доступ ещё не заблокирован (грейс-период джобы)
  SUSPENDED // доступ клуба заблокирован из-за неоплаты
  EXEMPT // клуб не платит подписку (статус «Енисея» как пилотного клиента)
}

/// Причина движения визитов по балансу абонемента (см. SubscriptionLedger).
enum LedgerReason {
  PURCHASE // начисление визитов при покупке абонемента
  VISIT_CHARGED // визит списан за состоявшееся посещение
  VISIT_REFUNDED // визит возвращён (клиент отменил вовремя)
  VISIT_BURNED // визит сгорел из-за неявки без отмены
  ADMIN_ADJUSTMENT // ручная корректировка администратором
  EXPIRED // остаток аннулирован по истечении срока абонемента
}

/// Откуда взялся визит в VisitLog.
enum VisitSourceType {
  TRAINING
  TOURNAMENT
  TABLE
  WALK_IN // первый визит клиента «с порога», без онлайн-брони
}

enum NotificationChannel {
  TELEGRAM
  WEB_PUSH
}

/// Тип уведомления, включая служебные эскалации по неотмеченному присутствию.
enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  ATTENDANCE_ESCALATION_HOUR // напоминание админу/руководству спустя час после мероприятия
  ATTENDANCE_AUTO_NO_SHOW // уведомление об автоматической фиксации неявки через сутки
  SUBSCRIPTION_PAST_DUE // клубу — про просрочку подписки на платформу
}

/// Кто выполнил действие в журнале аудита. Далеко не всё делают люди:
/// автоматическая неявка через сутки и захват холда по вебхуку — тоже
/// денежные операции, и у них должен быть различимый автор.
enum ActorType {
  USER // администратор, тренер, клиент
  SYSTEM_JOB // фоновая джоба (эскалация присутствия, биллинг подписки)
  WEBHOOK // входящее уведомление платёжного провайдера
}

/// Действия, попадающие в журнал аудита. Список намеренно узкий: сюда
/// пишется только то, что двигает деньги, меняет права или трогает
/// персональные данные, — иначе журнал превращается в свалку и в нём
/// невозможно ничего найти.
enum AuditAction {
  BOOKING_CREATED
  BOOKING_CANCELLED
  ATTENDANCE_MARKED // отмечено присутствие → списание по факту
  NO_SHOW_MARKED // отмечена неявка вручную → списание 100%
  AUTO_NO_SHOW_APPLIED // неявка зафиксирована джобой автоматически
  PAYMENT_HELD
  PAYMENT_CAPTURED
  PAYMENT_REFUNDED
  SUBSCRIPTION_BALANCE_ADJUSTED // ручная корректировка баланса абонемента
  PRICE_CHANGED // изменён прайс клуба или тип услуги
  CANCELLATION_POLICY_CHANGED
  ROLE_CHANGED
  CLIENT_ANONYMIZED // удаление персданных по требованию субъекта
  RANK_VERIFIED // администратор клуба подтвердил спортивный разряд игрока
  RANK_REJECTED // …или отклонил его, с причиной
  CHILD_ACCOUNT_CREATED // администратор завёл учётку ребёнка родителю у стойки
  GUARDIANSHIP_REVOKED // администратор снял закрепление ребёнка за родителем, с причиной
}

/// Закрепление ребёнка за родителем.
enum GuardianshipStatus {
  PENDING // заявка на чужую учётку ждёт ответа самого ребёнка
  ACTIVE // родитель ведёт ребёнка — пока тому нет 16
  REJECTED // ребёнок отказался, или заявку закрыло подтверждение другой
  REVOKED // закрепление сняли: родитель или администратор клуба ребёнка
}

/// Что за файл лежит в StoredFile. От вида зависят и лимит размера, и
/// допустимые форматы, и то, кому файл отдаётся (см. constraints.sql, раздел 18).
enum StoredFileKind {
  AVATAR // аватар игрока: приведён к 512×512 WebP, метаданные выброшены
  RANK_DOCUMENT // скан приказа о присвоении разряда: картинка или PDF
  COACH_PHOTO // фотография в карточке тренера: обработана как аватар
}

/// Уровень соревнования в достижении игрока.
enum AchievementLevel {
  INTERNATIONAL
  NATIONAL // всероссийское
  REGIONAL // краевое, областное
  CITY
  CLUB
}

/// Спортивный разряд или звание по ЕВСК. Порядок — от младшего к старшему.
enum SportRankLevel {
  YOUTH_3 // третий юношеский
  YOUTH_2
  YOUTH_1
  SPORT_3 // третий спортивный
  SPORT_2
  SPORT_1
  KMS // кандидат в мастера спорта
  MS // мастер спорта
  MSMK // мастер спорта международного класса
}

/// Проверка разряда клубом.
enum SportRankStatus {
  PENDING // заявлен игроком, ещё никто не смотрел — или игрок его поправил
  VERIFIED
  REJECTED
}

/// Тип юридического документа, который человек принимает.
enum LegalDocumentType {
  PUBLIC_OFFER // оферта клуба: условия услуг, холдирования и списания
  PERSONAL_DATA_CONSENT // согласие на обработку персональных данных (152-ФЗ)
  RECURRENT_PAYMENT_CONSENT // согласие на списания с сохранённой карты без ввода реквизитов
  PRIVACY_POLICY // политика обработки ПДн (документ платформы, не клуба)
}

// ---------------------------------------------------------------------------
// Клуб (Tenant) и его подписка на платформу
// ---------------------------------------------------------------------------

/// Клуб-арендатор платформы. Одна запись Tenant = один клуб настольного
/// тенниса со своими настройками, ценами и пользователями. Корень всей
/// изоляции данных: каждая таблица ниже несёт tenantId и связана с соседями
/// составным ключом, включающим его.
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ЧАСОВОГО ПОЯСА ЗДЕСЬ НЕТ. Он живёт на зале (Hall.timezone): залы одной
  // организации бывают в разных регионах, и общий на клуб пояс сдвинул бы в
  // одном из них и границы операционного дня, и порог «за час до начала», от
  // которого считаются деньги (ТЗ → «Профиль клуба»). Все моменты времени
  // хранятся в UTC (timestamptz); местное время — это время того зала, где
  // проходит мероприятие.

  // Основной город клуба — для карточки и поиска на стартовой странице.
  // Фактический город каждого зала указывается отдельно, на самом зале.
  // Поиск по городу находит клуб, если совпал город клуба ИЛИ город хотя бы
  // одного его зала: иначе клуб с залами в Красноярске и Абакане нашёлся бы
  // только по одному из них.
  cityId String?
  city   City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)

  // --- Оформление страницы клуба.
  //
  // ВНИМАНИЕ: в ТЗ брендинга клуба нет вовсе — это расширение, добавленное по
  // прямой просьбе владельца продукта. Логотип хранится ссылкой, а не файлом:
  // загрузка файлов тянет за собой валидацию, лимиты размера и раздачу
  // статики, а страница клуба работает и без них.
  logoUrl     String?
  /// Фирменный цвет в виде «#126b54». Формат проверяется CHECK'ом в
  /// constraints.sql: значение уезжает прямо в CSS-переменную, и мусор в нём
  /// означал бы сломанную вёрстку страницы клуба, а не пустое поле.
  accentColor String?

  /// Телефон и почта клуба для клиента: по ним звонят и пишут, не заводя
  /// учётку. У сотрудников телефон обязателен, а у самой организации его до
  /// 21.09.2026 не было нигде — страница клуба не могла ответить на первый же
  /// вопрос посетителя «как с вами связаться». Необязательные: клуб может
  /// работать без общего номера, и заставлять его выдумывать несуществующий
  /// хуже, чем показать одни адреса залов.
  phone String?
  email String?

  // Цены и шаг бронирования здесь НЕ лежат: они у зала (см. Hall). У клуба
  // может быть несколько залов с разным оборудованием и разной ценой, а вот
  // политика отмены и правила присутствия ниже — общие: это условия договора
  // клуба с клиентом, и различаться внутри одного клуба они не должны.

  // --- Политика отмены: настройка клуба, а не константа в коде.
  //
  // ВНИМАНИЕ: настраиваемость политики — решение уровня продукта, принятое
  // при проектировании схемы. В ТЗ политика описана как фиксированная
  // («за час — 0%, позже — 50%, неявка — 100%»), и для «Енисея» именно
  // такие значения и заводятся. Настраиваемой она сделана потому, что
  // продукт тиражируемый: у второго клуба пороги будут свои, и менять их
  // не должно означать релиз. Конкретные значения для других клубов с
  // владельцем не обсуждались.
  //
  // Ступени лежат в CancellationTier, здесь — то, что ступенями не выражается.
  noShowChargePercent Int @default(100) // сколько списать, если клиент не отменил и не пришёл

  // Мягкое правило для абонементов: визит сгорает только при неявке, а при
  // любой отмене возвращается на баланс (ТЗ → «Оплата и политика отмены»).
  subscriptionBurnsOnNoShowOnly Boolean @default(true)

  // Через сколько минут после мероприятия напоминать администратору, что
  // присутствие не отмечено, и через сколько — фиксировать неявку
  // автоматически. У «Енисея»: час и сутки.
  attendanceReminderAfterMinutes   Int @default(60)
  attendanceAutoNoShowAfterMinutes Int @default(1440)

  /// С какого момента клуб ведёт учёт присутствия.
  ///
  /// Записи, закончившиеся раньше, джоба автонеявки не трогает никогда. До
  /// появления отметки в продукте всё прошедшее так и осталось «записан» —
  /// отметить его было нечем, — и первый же прогон записал бы в неявки всю
  /// историю клуба, со списанием по 100%. Вручную старое отметить можно.
  ///
  /// У клубов, заведённых до отметки, — момент миграции; у новых — момент
  /// создания клуба.
  attendanceTrackedSince DateTime @default(now()) @db.Timestamptz(3)

  // --- Обратные связи: всё, что принадлежит этому клубу.
  memberships             TenantMembership[]
  clientProfiles          ClientProfile[]
  coachProfiles           CoachProfile[]
  cancellationTiers       CancellationTier[]
  trainingTypes           TrainingType[]
  trainingSessions        TrainingSession[]
  trainingBookings        TrainingBooking[]
  tournamentTypes         TournamentType[]
  tournaments             Tournament[]
  tournamentRegistrations TournamentRegistration[]
  halls                   Hall[]
  tables                  Table[]
  tableBookings           TableBooking[]
  tableClosureRules       TableClosureRule[]
  hallDaySchedules        HallDaySchedule[]
  dayClosures             DayClosure[]
  subscriptionPlans       SubscriptionPlan[]
  planTrainingTypes       SubscriptionPlanTrainingType[]
  planTournamentTypes     SubscriptionPlanTournamentType[]
  subscriptions           Subscription[]
  subscriptionLedger      SubscriptionLedger[]
  payments                Payment[]
  visitLogs               VisitLog[]
  notifications           Notification[]
  auditLogs               AuditLog[]
  legalDocuments          LegalDocument[]
  legalAcceptances        LegalAcceptance[]
  platformSubscription    TenantSubscription?
  favouritedBy            UserClub[]

  // Поиск клубов на стартовой странице фильтрует по городу — и клуба, и его
  // залов. Индекс завела миграция platform_layer, но в схему его тогда не
  // внесли, и Prisma с тех пор считала его лишним: следующая же миграция
  // молча предложила бы его удалить, а поиск по городу — поехать по всей
  // таблице. У Hall такой индекс объявлен, у Tenant не был.
  @@index([cityId])
}

/// Ступень политики отмены клуба: «если клиент отменил не позднее чем за
/// minMinutesBeforeStart минут до начала — списать chargePercent процентов».
///
/// Как считать: взять ступени клуба, отсортировать по minMinutesBeforeStart
/// по убыванию и выбрать первую, у которой порог не превышает фактический
/// запас времени до начала. Ступень с порогом 0 обязательна — она ловит все
/// поздние отмены и делает набор правил полным.
///
/// Для «Енисея» это ровно две строки:
///   { minMinutesBeforeStart: 60, chargePercent: 0 }   — отмена за час и раньше
///   { minMinutesBeforeStart: 0,  chargePercent: 50 }  — отмена позже
/// а неявка без отмены берётся из Tenant.noShowChargePercent = 100.
model CancellationTier {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  minMinutesBeforeStart Int
  chargePercent         Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, minMinutesBeforeStart])
}

/// Тарифный план платформы: за сколько и на какой срок клуб покупает доступ
/// к сервису. Не привязан к клубу — это прайс самой платформы, общий для
/// всех арендаторов.
///
/// Тарифы вынесены в таблицу, а не в enum с ценами: поднять цену не должно
/// означать миграцию БД. Строки при этом не редактируются — новая цена
/// заводится новой строкой, а старая помечается isActive = false. Иначе
/// правка цены задним числом переписала бы условия уже купленных подписок.
///
/// Значения «Енисея» из ТЗ заводятся сидом: 1 месяц — 5 000 ₽,
/// 12 месяцев — 50 000 ₽, 36 месяцев — 130 000 ₽ (в копейках).
/// Срок хранится числом месяцев, а не набором фиксированных периодов, —
/// чтобы добавить, скажем, полугодовой тариф тоже можно было без релиза.
model PlatformPlan {
  id           String @id @default(cuid())
  name         String // как показывать в интерфейсе: «Месяц», «Год», «3 года»
  periodMonths Int
  price        Int // копейки

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@index([isActive])
}

/// Подписка клуба на саму платформу (деньги «клуб → платформа»). Это не то
/// же самое, что клиентский абонемент (Subscription/SubscriptionPlan ниже) —
/// там деньги идут от клиента клубу за тренировки/турниры/аренду.
model TenantSubscription {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Тариф и зафиксированная цена покупки. Оба пусты только у клубов со
  // статусом EXEMPT — «Енисей» как пилотный клиент подписку не оплачивает,
  // и тарифа у него нет вовсе. Для всех остальных обязательны: это
  // проверяет check-констрейнт, см. schema-constraints.sql.
  //
  // priceAtPurchase — та же логика, что и priceAtBooking у броней: клуб
  // купил трёхлетний доступ за 130 000 ₽, и последующее изменение прайса
  // платформы не должно менять сумму его продлений задним числом.
  planId          String?
  plan            PlatformPlan? @relation(fields: [planId], references: [id], onDelete: Restrict)
  priceAtPurchase Int?

  status               PlatformSubscriptionStatus @default(ACTIVE)
  nextChargeDate       DateTime? // дата следующего автосписания ЮKassa — читает джоба биллинга
  savedPaymentMethodId String? // сохранённый способ оплаты клуба в ЮKassa
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([status, nextChargeDate])
}

// ---------------------------------------------------------------------------
// Пользователи
// ---------------------------------------------------------------------------

/// Учётная запись платформы. ОДНА на человека, а не по одной на каждый клуб:
/// клубу не принадлежит, роли не несёт и часового пояса не знает
/// (ТЗ → «Платформа и клубы: единый аккаунт»).
///
/// Здесь лежит только то, что не зависит от клуба: чем человек входит (почта,
/// пароль) и кто он такой (ФИО, телефон, дата рождения). Всё клубное — роль,
/// анкета, брони, платежи — висит на TenantMembership ниже.
///
/// Почему так, а не «учётка на клуб»: человек числится в «Енисее», иногда
/// играет в соседнем клубе и записывается в третий. С учёткой на клуб у него
/// три пароля и три истории, и ни один клуб не видит, что это один человек.
model User {
  id           String   @id @default(cuid())
  /// Почта уникальна ПО ВСЕЙ ПЛАТФОРМЕ, а не внутри клуба: второго аккаунта с
  /// тем же адресом завести нельзя. На этом стоит флоу «клиент с порога» —
  /// администратор не заводит человека заново, а привязывает существующий
  /// аккаунт к своему клубу (ТЗ → «Первый визит»).
  email        String   @unique
  /// Телефон в E.164: +79991234567. Обязателен для всех ролей — это основной
  /// канал связи клуба и с клиентом, и с сотрудником.
  phone        String
  /**
   * Дата рождения. Обязательна для всех: она нужна и клиенту (детские группы,
   * возрастные турниры), и сотруднику (кадровый учёт).
   * Тип DATE, а не отметка времени: у дня рождения нет часа, и хранить его
   * мгновением значит однажды сдвинуть на сутки в другом часовом поясе.
   */
  birthDate    DateTime @db.Date
  passwordHash String
  /// ФИО одной строкой, склеенное из трёх полей формы на сервере.
  ///
  /// Живёт здесь, а не в профиле роли: имя есть у любого пользователя —
  /// клиента, тренера, администратора, владельца. В ClientProfile оно
  /// оставляло тренера безымянным, а публичную карточку из ТЗ — нерабочей.
  ///
  /// Персональные данные по 152-ФЗ: при анонимизации затирается на
  /// «Удалённый пользователь» — там же, где затирается email.
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Мягкое удаление и анонимизация (152-ФЗ).
  //
  // Физически удалять клиента нельзя: за ним висят платежи и визиты, которые
  // нужны бухгалтерии и налоговой. Но субъект персональных данных вправе
  // потребовать прекратить их обработку. Поэтому два разных состояния:
  //
  //   deactivatedAt — учётка отключена, войти нельзя, данные на месте
  //                   (уволенный тренер, ушедший клиент);
  //   anonymizedAt  — персданные затёрты необратимо, финансовая история
  //                   сохранена в обезличенном виде.
  //
  // Здесь это ПЛАТФОРМЕННОЕ отключение: человек не входит вовсе. Отключение
  // в отдельно взятом клубе — другое состояние и живёт на
  // TenantMembership.deactivatedAt: уволенный тренер «Енисея» продолжает
  // играть в соседнем клубе, и его аккаунт трогать нельзя.
  //
  // Анонимизация ОБЯЗАНА затирать и email: он уникален по платформе, и
  // оставленный адрес не даст человеку зарегистрироваться заново. Штатный
  // приём — заменить на «deleted-<id>@invalid». Вместе с ним затираются
  // fullName и phone — это тоже персональные данные.
  deactivatedAt DateTime?
  anonymizedAt  DateTime?

  memberships    TenantMembership[]
  // Сессии входа висят на аккаунте, а не на клубе: человек входит на
  // платформу один раз и дальше сам выбирает, в какой клуб идёт.
  refreshTokens  RefreshToken[]
  // «Мои клубы» — отметка человека, а не клуба, поэтому висит на аккаунте.
  favouriteClubs UserClub[]

  // Профиль игрока — тоже свойство человека, а не клуба: разряд не меняется
  // от того, в каком зале человек сегодня играет.
  playerProfile PlayerProfile?
  achievements  Achievement[]
  sportRank     SportRank?
  files         StoredFile[]

  // Карточка тренера — тоже свойство человека: она одна на все клубы, где он
  // тренирует, и заполняет её он сам.
  coachCard CoachCard?

  // Семья: чьим ребёнком человек числится и чьим родителем.
  guardianshipsAsChild    Guardianship[] @relation("GuardianshipChild")
  guardianshipsAsGuardian Guardianship[] @relation("GuardianshipGuardian")
  guardianshipsCreated    Guardianship[] @relation("GuardianshipCreatedBy")
  guardianshipsRevoked    Guardianship[] @relation("GuardianshipRevokedBy")
}

// ---------------------------------------------------------------------------
// Семья: родитель и ребёнок
// ---------------------------------------------------------------------------

/// Закрепление ребёнка за родителем.
///
/// ВНИМАНИЕ: расширение сверх ТЗ, решения владельца продукта от 12.09 и
/// 17.09.2026. Пока ребёнку нет 16, родитель ведёт его: записывает, отменяет,
/// видит историю, ведёт профиль игрока; ребёнок только смотрит. Учётки у обоих
/// свои — с почтой и паролем: учёток без входа в продукте нет.
///
/// Висит на User, а не на клубе: ребёнок ходит в три клуба, а родитель у него
/// один на все.
///
/// Строки не удаляются и не переписываются в новое состояние задним числом:
/// это история прав на чужого человека. Возраст здесь не хранится и не
/// проверяется — `now()` в CHECK не выражается, — права кончаются в день
/// шестнадцатилетия сами (guardianship-rules.ts).
model Guardianship {
  id String @id @default(cuid())

  childUserId    String
  child          User   @relation("GuardianshipChild", fields: [childUserId], references: [id], onDelete: Cascade)
  guardianUserId String
  guardian       User   @relation("GuardianshipGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)

  status GuardianshipStatus

  /// Кто завёл: сам родитель — или администратор у стойки. NoAction, а не
  /// Restrict: удаление учётки (только пробные, clean-probes) уносит её строки
  /// каскадом по ребёнку или родителю одним оператором, а Restrict остановил
  /// бы этот каскад на полпути (см. PlayerProfile.avatar).
  createdByUserId String
  createdBy       User   @relation("GuardianshipCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction)

  /// Клуб, у стойки которого завели. Составной ключ на TenantMembership: база
  /// не примет администратора не из того клуба. Пусто — завёл сам родитель.
  createdInTenantId String?
  createdInClub     TenantMembership? @relation("GuardianshipCreatedInClub", fields: [createdByUserId, createdInTenantId], references: [userId, tenantId], onDelete: Restrict)

  confirmedAt DateTime? @db.Timestamptz(3)
  rejectedAt  DateTime? @db.Timestamptz(3)

  /// Кто снял закрепление: родитель — или администратор клуба ребёнка, тогда
  /// с клубом и причиной (constraints.sql, раздел 19).
  revokedAt         DateTime?         @db.Timestamptz(3)
  revokedByUserId   String?
  revokedBy         User?             @relation("GuardianshipRevokedBy", fields: [revokedByUserId], references: [id], onDelete: NoAction)
  revokedInTenantId String?
  revokedInClub     TenantMembership? @relation("GuardianshipRevokedInClub", fields: [revokedByUserId, revokedInTenantId], references: [userId, tenantId], onDelete: Restrict)
  revokeReason      String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // «Родитель один» и «одна заявка от одного взрослого» — частичными
  // уникальными индексами в constraints.sql: обычный @@unique запретил бы
  // закрепить ребёнка заново после снятия.
  @@index([childUserId, status])
  @@index([guardianUserId, status])
  @@index([createdByUserId, createdInTenantId])
  @@index([revokedByUserId, revokedInTenantId])
}

// ---------------------------------------------------------------------------
// Профиль игрока
// ---------------------------------------------------------------------------
//
// ВНИМАНИЕ: расширение сверх ТЗ, решение владельца продукта от 12.09.2026. В
// ТЗ у клиента есть только справочный рейтинг (ClientProfile.rating), а фото,
// инвентарь и достижения описаны лишь у тренера.
//
// Всё здесь висит на User, а не на TenantMembership: аккаунт один на
// платформу, и разряд, подтверждённый одним клубом, действует во всех.
// Удаление каскадное — это персональные данные без денежных следов, и при
// удалении учётки им оставаться незачем (152-ФЗ).

/// Загруженный файл. Байты лежат в Postgres, за интерфейсом FileStorage:
/// хостинга с объектным хранилищем пока нет, а переезд в S3 — это замена
/// одного модуля, а не схемы связей.
///
/// Файл заменяется, а не копится: новый аватар — новая строка, старая
/// удаляется в той же транзакции. У истории денег удаления нет, а у
/// персональных данных оно обязано быть.
model StoredFile {
  id          String         @id @default(cuid())
  ownerUserId String
  owner       User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  kind        StoredFileKind

  /// Тип определён по сигнатуре байтов, а не взят из заголовка запроса:
  /// заголовок пишет клиент, и «image/png» на HTML-файле ничего не стоит.
  contentType String
  size        Int
  /// SHA-256 содержимого, шестнадцатеричный. Проверка целостности при
  /// переезде в объектное хранилище.
  sha256      String
  data        Bytes

  createdAt DateTime @default(now())

  avatarOf       PlayerProfile[] @relation("ProfileAvatar")
  rankDocumentOf SportRank[]     @relation("RankDocument")
  coachPhotoOf   CoachCard[]     @relation("CoachPhoto")

  // Мишень составных ключей: аватар и приказ ссылаются на пару (файл,
  // владелец), и база не примет чужой файл в своём профиле.
  @@unique([id, ownerUserId])
  @@index([ownerUserId])
}

/// Карточка игрока: аватар и инвентарь. Заполняет сам человек в «Кабинете».
///
/// Инвентарь — свободный текст: каталога оснований и накладок нет, и
/// заводить его ради трёх полей незачем.
model PlayerProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Ключ составной — (файл, этот же человек): чужой файл аватаром не станет.
  ///
  /// NoAction, а не Restrict: при удалении учётки каскад уносит и профиль, и
  /// файл одним оператором, и Restrict остановил бы его на полпути, если бы
  /// файл удалялся первым. NoAction проверяет связь в конце оператора, когда
  /// профиля уже нет, — а удалить файл из-под живого профиля по-прежнему нельзя.
  avatarFileId String?     @unique
  avatar       StoredFile? @relation("ProfileAvatar", fields: [avatarFileId, userId], references: [id, ownerUserId], onDelete: NoAction)

  blade          String? // основание
  forehandRubber String? // накладка справа
  backhandRubber String? // накладка слева

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Достижение — строка из списка, который игрок ведёт сам, без
/// подтверждения. Результатов турниров система не хранит, поэтому
/// достижения с турниров клуба сами сюда не попадают.
model Achievement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String // «Первенство Красноярского края, мужской одиночный разряд»
  /// Дата соревнования. DATE, а не отметка времени — по той же причине, что у
  /// дня рождения: у неё нет часа.
  date  DateTime         @db.Date
  level AchievementLevel
  /// Занятое место; пусто — «участие».
  place Int?
  note  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

/// Спортивный разряд игрока и его проверка клубом.
///
/// Подтверждает администратор любого клуба, где человек состоит, и
/// подтверждение действует на всей платформе с подписью «подтвердил клуб X».
/// Правка разряда игроком возвращает его на проверку.
model SportRank {
  userId String         @id
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank   SportRankLevel

  // Обоснование: номер и дата приказа вместе — либо скан приказа. Одно из
  // двух обязательно (constraints.sql, раздел 18).
  orderNumber String?
  orderDate   DateTime? @db.Date

  /// Скан приказа. Видят только сам человек и администраторы его клубов —
  /// там паспортные данные и дата рождения.
  documentFileId String?     @unique
  document       StoredFile? @relation("RankDocument", fields: [documentFileId, userId], references: [id, ownerUserId], onDelete: NoAction)

  status SportRankStatus @default(PENDING)

  /// Кто и в каком клубе принял решение. Ключ составной и целится в
  /// TenantMembership: база не примет проверяющего не из того клуба, который
  /// значится в подписи. Что он там администратор, а игрок там состоит, —
  /// проверяет сервис: это сравнение строк других таблиц.
  reviewedByUserId   String?
  reviewedInTenantId String?
  reviewedBy         TenantMembership? @relation("RankReviews", fields: [reviewedByUserId, reviewedInTenantId], references: [userId, tenantId], onDelete: Restrict)
  reviewedAt         DateTime?         @db.Timestamptz(3)
  rejectionReason    String?

  createdAt DateTime @default(now())
  /// Версия для проверки «разряд не изменился, пока администратор смотрел
  /// карточку»: решение принимается о том, что он видел, а не о том, что
  /// игрок успел поправить за это время.
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([reviewedByUserId, reviewedInTenantId])
}

/// «Мои клубы»: избранное и заявленная принадлежность одновременно.
///
/// Одна сущность, а не две. Разделять «избранный клуб» и «мой клуб» значило бы
/// объяснять человеку разницу, которой в его голове нет (ТЗ → «Мои клубы»).
/// Отмечает он сам: ни заявки, ни подтверждения администратором нет.
///
/// Отдельно от TenantMembership: привязка появляется САМА, первой же записью
/// человека в клуб, а своим клуб отмечают осознанно. Клуб видит своих отдельно
/// от тех, кто записался разово.
///
/// На Этапе 1 принадлежность не даёт ничего, кроме видимости: цены, доступ к
/// записи и правила отмены одинаковы для всех.
///
/// ПРЕДЕЛ В ТРИ КЛУБА ВЫРАЖЕН СТРУКТУРОЙ, А НЕ ТРИГГЕРОМ. `slot` — занятое
/// место, 1..3, уникальное в пределах человека (см. constraints.sql). Поэтому
/// четвёртый клуб физически некуда положить, и правило проверяет база, а не
/// код: проверка «а сколько уже есть?» в сервисе не спасает от гонки двух
/// параллельных запросов. Человеку слоты не показываются — сервер занимает
/// наименьший свободный.
model UserClub {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  slot Int

  createdAt DateTime @default(now())

  @@id([userId, tenantId])
  @@unique([userId, slot])
  @@index([tenantId])
}

/// Город из справочника платформы.
///
/// Справочник, а не строка в карточке клуба: свободный ввод даёт «Красноярск»,
/// «г. Красноярск» и «краснярск» тремя разными городами, и поиск по городу
/// перестаёт работать (ТЗ → «Профиль клуба»).
///
/// Наполняется сидом и правится вместе с ним. Заведение города силами
/// администратора клуба вернуло бы ровно ту проблему, ради которой справочник
/// и появился.
model City {
  id     String  @id @default(cuid())
  name   String
  /// Регион — чтобы различить одноимённые города («Железногорск» есть и в
  /// Красноярском крае, и в Курской области).
  region String?

  createdAt DateTime @default(now())

  tenants Tenant[]
  halls   Hall[]

  /// Уникальна пара, а не одно название: одноимённые города в разных регионах
  /// законны, а два «Красноярска» в одном — нет.
  @@unique([name, region])
}

/// Пара «человек + клуб»: чем этот аккаунт является в этом клубе.
///
/// Несущий элемент изоляции. Всё клубное — анкеты, брони, платежи, визиты,
/// уведомления, согласия — ссылается СЮДА по (userId, tenantId), а не на
/// User: у User клуба нет, и без этой таблицы составные ключи не на что
/// опереть. База по-прежнему не примет бронь, где стол одного клуба, а клиент
/// другого, — просто цепочка стала на звено длиннее.
///
/// Заводится первым же действием человека в клубе (ТЗ → «Один аккаунт на все
/// клубы»): вступать в клуб, чтобы забронировать стол, не требуется. Клуб
/// видит такого человека в своём составе как обычного клиента.
///
/// Своего id нет намеренно: у привязки нет собственной сущности сверх пары
/// «кто + где», а лишний суррогатный ключ пришлось бы держать уникальным
/// вместе с tenantId ровно для того же, что уже делает первичный ключ.
model TenantMembership {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Роль В ЭТОМ клубе. Один аккаунт бывает клиентом в одном клубе, тренером
  /// во втором и владельцем в третьем — «прав вообще на платформе» нет ни у
  /// кого (ТЗ → «Роли и права доступа»).
  role Role @default(CLIENT)

  /// Отключение человека В ЭТОМ клубе: уволенный тренер, ушедший клиент.
  /// Аккаунт при этом жив и работает в других клубах. Строка не удаляется —
  /// за ней стоят платежи и история визитов.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile    ClientProfile? // заполнен, если role = CLIENT
  coachProfile     CoachProfile? // заполнен, если role = COACH
  notifications    Notification[]
  visitsRecorded   VisitLog[]        @relation("VisitRecordedBy")
  legalAcceptances LegalAcceptance[]
  auditEntries     AuditLog[]        @relation("AuditActor")

  // Записи, заведённые этим сотрудником вручную. Мишень та же, что у
  // visitsRecorded, и по той же причине: автор записи обязан быть человеком
  // ЭТОГО клуба, и следит за этим составной внешний ключ, а не код.
  tableBookingsCreated           TableBooking[]           @relation("TableBookingAuthor")
  trainingBookingsCreated        TrainingBooking[]        @relation("TrainingBookingAuthor")
  tournamentRegistrationsCreated TournamentRegistration[] @relation("TournamentRegistrationAuthor")

  // Разряды, проверенные этим администратором от имени этого клуба.
  rankReviews SportRank[] @relation("RankReviews")

  // Закрепления ребёнка за родителем, заведённые и снятые у стойки клуба.
  guardianshipsCreatedInClub Guardianship[] @relation("GuardianshipCreatedInClub")
  guardianshipsRevokedInClub Guardianship[] @relation("GuardianshipRevokedInClub")

  // Абонементы, проданные этим сотрудником, и его ручные корректировки баланса.
  subscriptionsSold  Subscription[]       @relation("SubscriptionSeller")
  ledgerEntriesAdded SubscriptionLedger[] @relation("SubscriptionLedgerAuthor")

  // Первичный ключ и одновременно мишень всех составных FK клубных таблиц.
  @@id([userId, tenantId])
  @@index([tenantId, role])
}

/// Данные клиента: анкета + всё, что с ним связано (брони, абонементы,
/// платежи, история визитов).
///
/// Анкета РОЛИ В КЛУБЕ, а не человека: ключ — та же пара (userId, tenantId),
/// что у TenantMembership, и рейтинг клиента в «Енисее» ничего не говорит о
/// нём же в соседнем клубе.
model ClientProfile {
  // Ключ составной, а не один userId: аккаунт глобальный, и один человек
  // законно является клиентом в трёх клубах сразу — это три анкеты, а не
  // одна. Пока User принадлежал клубу, разницы не было, и userId в одиночку
  // за первичный ключ сходил.
  userId               String
  tenantId             String // вторая половина ключа привязки к клубу
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership           TenantMembership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)
  // Персональные данные по 152-ФЗ. При анонимизации затираются на
  // плейсхолдеры (null), а строки Payment и VisitLog остаются — они
  // обезличены и нужны для бухгалтерии. ФИО, телефон и дата рождения живут в
  // User: они есть у любой роли, а не только у клиента.
  rating               Int? // справочное поле, без проверки/гейта на регистрацию (см. ТЗ → «Вне скоупа»)
  savedPaymentMethodId String? // сохранённый способ оплаты в ЮKassa — привязывается один раз при регистрации

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Окон расписания у клиента нет: время, закреплённое за человеком, — это
  // бронь, а не окно. Кисть «Аренда» с клиентом заводит TableBooking.
  trainingBookings        TrainingBooking[]
  tournamentRegistrations TournamentRegistration[]
  tableBookings           TableBooking[]           @relation("ClientTableBookings")
  subscriptions           Subscription[]
  payments                Payment[]
  visitLogs               VisitLog[]

  @@id([userId, tenantId])
}

/// Публичная карточка тренера — ОДНА на человека, общая для всех клубов, где
/// он тренирует.
///
/// Решение владельца от 20.09.2026: у тренера, как и у игрока, один профиль на
/// платформу. Заполняет его только он сам; клуб карточку не правит — в отличие
/// от того, что написано в ТЗ («либо admin/owner любую»). Клубным осталось
/// только то, что у клубов действительно разное, — цены (см. CoachProfile).
model CoachCard {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Фотография лежит файлом, а не адресом: внешней ссылке нечем подтвердить,
  /// что за ней картинка. Ключ составной — (файл, этот же человек), NoAction —
  /// по тем же причинам, что у `PlayerProfile.avatarFileId`; карточка теперь
  /// прямой потомок учётки, и каскад уносит их одной волной.
  photoFileId String?     @unique
  photo       StoredFile? @relation("CoachPhoto", fields: [photoFileId, userId], references: [id, ownerUserId], onDelete: NoAction)

  achievements String?
  inventory    String?
  socialLinks  Json? // ссылки на соцсети: [{ label, url }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Тренер в клубе: его цены здесь и служебные связи (какие сессии ведёт, чью
/// статистику считать). Публичная карточка — общая, CoachCard.
model CoachProfile {
  // Составной ключ по той же причине, что у ClientProfile: тренер одного
  // клуба и клиент другого — это один аккаунт с двумя анкетами.
  userId     String
  tenantId   String // вторая половина ключа привязки к клубу
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  /// Цены этого тренера В ЭТОМ клубе, копейки. Сама карточка — общая на все
  /// клубы (CoachCard), а цены клубные: в соседнем клубе у того же тренера
  /// другой прайс (решение владельца от 20.09.2026).
  groupPrice      Int?
  individualPrice Int?

  /// Необязательная приписка к ценам: «первое занятие бесплатно».
  priceNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closureRules     TableClosureRule[]
  dayClosures      DayClosure[]
  trainingSessions TrainingSession[] // сессии, которые ведёт этот тренер
  tableBookings    TableBooking[]     @relation("CoachTableBookings") // брони стола, инициированные тренером (спарринги)
  visitLogs        VisitLog[] // визиты его учеников — для статистики посещаемости

  @@id([userId, tenantId])
}

// ---------------------------------------------------------------------------
// Тренировки
// ---------------------------------------------------------------------------

/// Тип тренировки клуба (напр. «Общая групповая», «Детская», «Первая
/// подача»). Определяет ТЕКУЩУЮ цену; список редактирует admin/owner.
/// Важно: цена отсюда — только для новых броней. Уже созданные брони хранят
/// свою копию цены (priceAtBooking), поэтому смена прайса не переписывает
/// историю задним числом.
model TrainingType {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  price     Int // копейки
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          TrainingSession[]
  closureRules      TableClosureRule[]
  dayClosures       DayClosure[]
  subscriptionPlans SubscriptionPlanTrainingType[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Конкретное занятие — сущность-сессия (тренер, интервал, лимит мест),
/// а не «тренировка вообще на день». В один будний день может быть
/// несколько сессий у разных тренеров с разными лимитами.
model TrainingSession {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  trainingTypeId String
  trainingType   TrainingType @relation(fields: [trainingTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)
  coachId        String
  coach          CoachProfile @relation(fields: [coachId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  // Один интервал вместо прежней пары date + startTime: два поля позволяли
  // записать несогласованные дату и время. Timestamptz — потому что от
  // момента старта зависят деньги (порог отмены «за 1 час»), а клуб живёт
  // не в UTC.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  capacity  Int // лимит мест в группе
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings    TrainingBooking[]
  dayClosures DayClosure[]

  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
}

/// Запись клиента на конкретную тренировочную сессию.
model TrainingBooking {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessionId String
  session   TrainingSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  clientId  String
  client    ClientProfile   @relation(fields: [clientId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  status    BookingStatus   @default(BOOKED)
  source    BookingSource   @default(ONLINE) // ONLINE — клиент записался сам; MANUAL — добавил admin

  /// Кто из сотрудников завёл запись вручную. Обязательно при source = MANUAL,
  /// см. TableBooking.createdByUserId — там же и объяснение.
  createdByUserId String?
  createdBy       TenantMembership? @relation("TrainingBookingAuthor", fields: [createdByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  // Копия цены на момент записи (копейки). Без неё изменение прайса или
  // удаление типа тренировки исказило бы всю историю. Заполняется и при
  // оплате абонементом — иначе стоимость визита не восстановить вообще.
  priceAtBooking Int

  /// Абонемент, которым оплачена запись. Пусто — запись по цене.
  ///
  /// Ключ по трём полям: абонемент обязан принадлежать клиенту ЭТОЙ записи.
  /// У записи по абонементу chargeRatio — судьба визита: 0 — возвращён,
  /// 100 — израсходован (CHECK), а не доля цены.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId, clientId, tenantId], references: [id, clientId, tenantId], onDelete: Restrict)

  cancelledAt DateTime? @db.Timestamptz(3)
  chargeRatio Int? // процент списания по политике отмены клуба (0..100)
  paymentId   String?   @unique
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  // --- Следы работы джобы эскалации присутствия.
  // Без них джоба не идемпотентна: она отбирает брони, у которых занятие
  // прошло, а присутствие не отмечено, — и на каждом прогоне заново шлёт
  // администратору одно и то же напоминание. Отметки времени превращают
  // «надо ли слать» из вопроса о времени в вопрос о факте.
  reminderSentAt      DateTime? @db.Timestamptz(3)
  autoNoShowAppliedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitLogs     VisitLog[]
  ledgerEntries SubscriptionLedger[]

  // Повторную запись того же клиента на ту же сессию запрещает частичный
  // уникальный индекс (только для status = BOOKED) — см. schema-constraints.sql.
  // Обычный @@unique здесь не годится: он запретил бы записаться заново
  // после отмены.
  @@unique([id, tenantId])
  @@index([sessionId])
  @@index([clientId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Турниры
// ---------------------------------------------------------------------------

/// Тип турнира клуба (напр. «Абсолют», «Клуб 100», «Пятничное турне»).
/// Список из 6 базовых типов редактирует admin: добавляет/меняет/удаляет.
model TournamentType {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  ratingLabel String? // справочное число-ограничение в названии (напр. «100» у «Клуб 100») — не проверяется системой, чисто информация для игрока
  price       Int // текущая цена участия, копейки
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tournaments       Tournament[]
  closureRules      TableClosureRule[]
  subscriptionPlans SubscriptionPlanTournamentType[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Конкретный турнир клуба на определённую дату (обычно по выходным).
model Tournament {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tournamentTypeId String
  tournamentType   TournamentType @relation(fields: [tournamentTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  startsAt DateTime @db.Timestamptz(3)

  /// Когда турнир заканчивается.
  ///
  /// Без него экран смены не знает, когда турнир «закончился и ждёт
  /// отметки», а джоба — когда фиксировать неявку. Одно значение, которое
  /// читают оба, а не вывод из окон расписания: у турнира, заведённого не в
  /// сетке, окон нет вовсе, и второй расчёт разошёлся бы с первым. Правка дня
  /// в расписании пересчитывает его по концу своих окон.
  endsAt DateTime @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  registrations TournamentRegistration[]
  dayClosures   DayClosure[]

  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
}

/// Регистрация клиента на турнир — та же механика отмены/неявки, что и у
/// TrainingBooking.
model TournamentRegistration {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tournamentId String
  tournament   Tournament    @relation(fields: [tournamentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  clientId     String
  client       ClientProfile @relation(fields: [clientId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  status       BookingStatus @default(BOOKED)

  /// Как появилась регистрация: клиент записался сам или её завёл админ.
  /// Заведено вместе с тем же полем у аренды — у записи на тренировку оно
  /// было изначально, и отсутствие у двух других выглядело забытой строкой.
  source BookingSource @default(ONLINE)

  /// Кто из сотрудников завёл регистрацию вручную. Обязательно при
  /// source = MANUAL, см. TableBooking.createdByUserId.
  createdByUserId String?
  createdBy       TenantMembership? @relation("TournamentRegistrationAuthor", fields: [createdByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  /// Абонемент, которым оплачена регистрация, — см. TrainingBooking.subscriptionId.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId, clientId, tenantId], references: [id, clientId, tenantId], onDelete: Restrict)

  priceAtBooking Int // копия цены участия на момент регистрации, копейки

  cancelledAt DateTime? @db.Timestamptz(3)
  chargeRatio Int?
  paymentId   String?   @unique
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  // Следы джобы эскалации присутствия — см. TrainingBooking.
  reminderSentAt      DateTime? @db.Timestamptz(3)
  autoNoShowAppliedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitLogs     VisitLog[]
  ledgerEntries SubscriptionLedger[]

  // Повторная регистрация запрещена частичным уникальным индексом,
  // см. schema-constraints.sql.
  @@unique([id, tenantId])
  @@index([tournamentId])
  @@index([clientId])
  @@index([tenantId, status])
}

// ---------------------------------------------------------------------------
// Столы / робот / спарринг
// ---------------------------------------------------------------------------

/// Один физический стол клуба (просто идентифицируемый ресурс — цены и
/// доступность робота настраиваются на уровне Tenant, не по каждому столу).
/// Зал клуба: помещение со своим набором столов и своей ценой.
///
/// У клуба их может быть несколько, и различаются они именно тем, что стоит
/// денег: оборудованием, размером, наличием роботов. Поэтому цены и
/// минимальный шаг брони живут здесь, а не на клубе.
///
/// Политика отмены, правила присутствия и абонементы сюда НЕ переезжают: это
/// условия договора клуба с клиентом, и разные правила отмены в двух залах
/// одного клуба пришлось бы отдельно оговаривать в оферте.
model Hall {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name     String // «Основной зал», «Малый зал»

  /// Часовой пояс зала в формате IANA (напр. «Asia/Krasnoyarsk»).
  ///
  /// Именно зала, а не клуба: залы одной организации бывают в разных
  /// регионах. Не косметика — от пояса зависят деньги и отчётность. Все
  /// моменты времени хранятся в UTC (timestamptz), но «за час до начала»,
  /// «сутки на отметку присутствия» и границы операционного дня считаются в
  /// местном времени ЗАЛА, где мероприятие и проходит.
  timezone String @default("Asia/Krasnoyarsk")

  /// Фактический город зала. У клуба свой, «основной», — поиск по городу
  /// находит клуб по совпадению любого из них.
  cityId  String?
  city    City?   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  /// Адрес зала для клиента. Поиском не используется — для него есть город.
  address String?

  // Цены — в копейках. Количество столов отдельным полем не хранится: столы —
  // это строки в Table, и счётчик рядом с ними неизбежно разошёлся бы с
  // реальностью (добавили стол, забыли обновить число).
  bookingStep          BookingStep @default(MIN_30) // минимальный шаг брони стола
  tableHourPrice       Int // цена 1 часа аренды стола без робота
  tableExtra30MinPrice Int // доплата за каждые следующие 30 минут без робота
  hasRobotOption       Boolean     @default(false) // есть ли аренда «стол + робот»
  robot30MinPrice      Int? // цена 30 минут с роботом (своя сетка цен)
  robot60MinPrice      Int? // цена 60 минут с роботом
  robotExtra30MinPrice Int? // доплата за каждые следующие 30 минут с роботом

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables            Table[]
  daySchedules      HallDaySchedule[]
  subscriptionSales Subscription[]    @relation("SubscriptionSale")

  // Мишень для составных FK: стол не может попасть в зал чужого клуба.
  @@unique([id, tenantId])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([cityId])
}

model Table {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  hallId    String
  hall      Hall     @relation(fields: [hallId, tenantId], references: [id, tenantId], onDelete: Restrict)
  label     String // например «Стол 1»
  createdAt DateTime @default(now())

  bookings     TableBooking[]
  closureRules TableClosureRule[]
  dayClosures  DayClosure[]

  @@unique([id, tenantId])
  // Название уникально В ПРЕДЕЛАХ ЗАЛА, а не клуба: «Стол 1» законно есть и
  // в основном зале, и в малом.
  @@unique([hallId, label])
  @@index([tenantId])
  @@index([hallId])
}

/// Регулярно закрытое время стола: постоянное недельное правило.
///
/// Клуб живёт по расписанию — групповые тренировки, секции, детские группы
/// занимают часть столов в одни и те же часы каждую неделю. Заводить это
/// разовыми окнами значит переписывать их вручную каждую неделю, а однажды
/// забыть — и стол уйдёт клиенту прямо под тренировку.
///
/// Закрыто ТОЛЬКО для клиента: администратор посадить человека за такой стол
/// по-прежнему может. Жизнь в зале всегда сложнее расписания, и тупик здесь
/// обошёлся бы дороже ошибки.
///
/// Одна строка — один стол: «закрыть столы 1 и 2» это две строки. Так
/// хранение совпадает с тем, что администратор видит в сетке, и не нужна
/// таблица связей ради множества столов в одном правиле.
model TableClosureRule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tableId  String
  table    Table  @relation(fields: [tableId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// День недели по ISO-8601: 1 — понедельник, 7 — воскресенье.
  weekday Int

  /// Чем занят стол. Обязательно: «просто закрыто» ничего не говорит ни
  /// администратору через месяц, ни статистике.
  purpose ClosurePurpose @default(OTHER)

  /// Тренер, ведущий занятие. Обязателен при purpose = TRAINING — иначе
  /// проведённая тренировка не попадёт в статистику тренера и разбираться,
  /// кто её вёл, придётся по памяти. Допустим ещё у спарринга; для аренды,
  /// робота и прочего запрещён (см. constraints.sql).
  coachId String?
  coach   CoachProfile? @relation(fields: [coachId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  // КЛИЕНТА У ОКНА НЕТ. Он тут был — «закреплённый арендатор», — и это
  // оказалось ловушкой: окно не несёт ни цены, ни статуса, ни отмены, а
  // человек, которого администратор вписал кистью «Аренда», считал себя
  // записанным. В «Моих записях» у него при этом было пусто. Теперь такое
  // время — бронь (TableBooking), а окно только закрывает стол.

  /// Какая это тренировка: «Общая групповая», «Первая подача». Обязателен при
  /// purpose = TRAINING — от типа зависит цена, а «просто тренировка» в
  /// расписании не говорит клиенту ничего.
  trainingTypeId String?
  trainingType   TrainingType? @relation(fields: [trainingTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// ТИП турнира, а не сам турнир. Обязателен при purpose = TOURNAMENT.
  ///
  /// В шаблоне недели хранится именно тип: «каждую субботу с 10:00 идёт
  /// турнир» — законное описание жизни клуба, а конкретное проведение с датой
  /// заводится, когда администратор открывает эту дату и сохраняет её
  /// расписание.
  tournamentTypeId String?
  tournamentType   TournamentType? @relation(fields: [tournamentTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// Границы окна в минутах от полуночи ПО ВРЕМЕНИ КЛУБА (Tenant.timezone),
  /// а не в UTC. Правило «каждый вторник с 15:00» должно оставаться в силе
  /// вне зависимости от того, какому мгновению UTC это соответствует.
  /// Полночь как конец окна — это 1440, а не 0: иначе интервал вывернулся бы.
  startMinute Int
  endMinute   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, weekday])
  @@index([tableId])
  @@index([coachId])
  @@index([trainingTypeId])
  @@index([tournamentTypeId])
}

/// Расписание зала на конкретную дату.
///
/// Шаблон недели (TableClosureRule) описывает, как зал живёт обычно. Эта
/// таблица говорит «а вот двенадцатого марта было иначе»: строка-заголовок
/// на пару «зал + дата» означает, что на эту дату шаблон НЕ применяется, а
/// действует то, что лежит в её DayClosure.
///
/// Заголовок нужен отдельной строкой, потому что пустое расписание дня — это
/// осмысленное состояние: «в эту субботу тренировок нет, все столы свободны».
/// Без заголовка отсутствие записей нельзя было бы отличить от «день не
/// правили», и суббота молча вернулась бы к шаблону.
model HallDaySchedule {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hallId   String
  hall     Hall   @relation(fields: [hallId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Календарная дата ПО ВРЕМЕНИ КЛУБА, без часов. Именно дата, а не
  /// мгновение: «двенадцатое марта» в зале начинается в местную полночь.
  date DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  closures DayClosure[]

  @@unique([hallId, date])
  @@index([tenantId, date])
}

/// Занятое время стола на конкретную дату — то же, что окно шаблона, но
/// внутри расписания одного дня.
model DayClosure {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId String
  schedule   HallDaySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  tableId    String
  table      Table           @relation(fields: [tableId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Границы в минутах от местной полуночи, как и в шаблоне. Полночь как
  /// конец окна — 1440, а не 0.
  startMinute Int
  endMinute   Int

  /// Назначение, тренер, клиент и тип тренировки — те же правила, что в
  /// шаблоне недели (см. TableClosureRule).
  purpose        ClosurePurpose @default(OTHER)
  coachId        String?
  coach          CoachProfile?  @relation(fields: [coachId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  // Клиента нет — см. TableClosureRule.
  trainingTypeId String?
  trainingType   TrainingType?  @relation(fields: [trainingTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// Турнир, занявший это время. Обязателен при purpose = TOURNAMENT и
  /// возможен только здесь: у турнира конкретная дата, и в постоянном
  /// расписании недели ему места нет.
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// Занятие, ради которого стол закрыт. Возможен только при purpose =
  /// TRAINING и, в отличие от турнира, НЕ обязателен: администратор законно
  /// закрывает стол под индивидуальное занятие, на которое никто не
  /// записывается, — сессии с лимитом мест у такого занятия нет.
  ///
  /// Когда ссылка есть, занятое время стола и сессия, на которую идёт запись,
  /// становятся одним фактом. Без неё они два независимых списка, которым
  /// ничто не мешает разойтись: занятие отменили в расписании, а запись на
  /// него осталась открытой.
  ///
  /// В шаблоне недели (TableClosureRule) такого поля нет и быть не может — по
  /// той же причине, что и у турнира: шаблон повторяется, а у сессии
  /// конкретная дата.
  trainingSessionId String?
  trainingSession   TrainingSession? @relation(fields: [trainingSessionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
  @@index([tableId])
  @@index([coachId])
  @@index([trainingTypeId])
  @@index([tournamentId])
  @@index([trainingSessionId])
}

/// Бронь стола: самостоятельная онлайн-аренда клиента (без подтверждения
/// администратора) либо спарринг, инициированный тренером тем же механизмом.
///
/// Двойное бронирование одного стола на пересекающееся время запрещено
/// exclusion-констрейнтом Postgres (btree_gist по tableId + диапазону
/// времени) — см. schema-constraints.sql. Проверкой в коде это надёжно не
/// решается: два параллельных запроса оба увидят стол свободным.
model TableBooking {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tableId  String
  table    Table  @relation(fields: [tableId, tenantId], references: [id, tenantId], onDelete: Restrict)

  // Ровно одно из двух полей заполнено: клиент бронирует сам себе (clientId),
  // либо тренер инициирует спарринг (coachId + isSparring = true).
  // Проверяется check-констрейнтом, см. schema-constraints.sql.
  clientId String?
  client   ClientProfile? @relation("ClientTableBookings", fields: [clientId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  coachId  String?
  coach    CoachProfile?  @relation("CoachTableBookings", fields: [coachId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  isSparring Boolean @default(false)
  withRobot  Boolean @default(false) // отдельная услуга со своей сеткой цен, не наценка поверх обычной аренды

  /// Как появилась бронь: клиент занял стол сам или её завёл администратор.
  ///
  /// У TrainingBooking такое поле было с самого начала, а у аренды и
  /// регистрации на турнир — нет, и это выглядело забытой строкой, а не
  /// решением. Без него нельзя ответить на первый же вопрос к рабочему месту
  /// через месяц: сколько броней клуб заводит руками по телефону.
  source BookingSource @default(ONLINE)

  /// Кто из сотрудников завёл бронь вручную. Пусто у самостоятельной онлайн-
  /// брони: клиент сам себе не «автор».
  ///
  /// Обязательно при source = MANUAL — это проверяет check-констрейнт. За
  /// админской бронью стоят чужие деньги, и «кто меня записал» — первый
  /// вопрос при споре; восстановить ответ больше неоткуда, потому что
  /// AuditLog на этом этапе не пишется.
  ///
  /// Ключ составной и целится в TenantMembership — ровно та же мишень, что у
  /// VisitLog.recordedBy: база не примет автора из чужого клуба.
  createdByUserId String?
  createdBy       TenantMembership? @relation("TableBookingAuthor", fields: [createdByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  // Явный интервал вместо startTime + durationMinutes: exclusion-констрейнту
  // нужен диапазон, а длительность выводится как endsAt - startsAt.
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  priceAtBooking Int // копия рассчитанной стоимости аренды на момент брони, копейки

  status      BookingStatus @default(BOOKED)
  cancelledAt DateTime?     @db.Timestamptz(3)
  chargeRatio Int?
  paymentId   String?       @unique
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  // Следы джобы эскалации присутствия — см. TrainingBooking.
  reminderSentAt      DateTime? @db.Timestamptz(3)
  autoNoShowAppliedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitLogs     VisitLog[]
  ledgerEntries SubscriptionLedger[]

  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
  @@index([tableId, startsAt])
  // Рабочий запрос джобы эскалации: «брони этого клуба, всё ещё BOOKED,
  // у которых занятие уже закончилось». Без составного индекса это
  // последовательное чтение всей таблицы на каждом прогоне.
  @@index([tenantId, status, endsAt])
  // «Брони этого человека в этом клубе, свежие сверху» — запрос кабинета
  // клиента (BookingService.listMine) и карточки человека в рабочем месте.
  // По clientId индекса не было вовсе, хотя оба запроса по нему уже ходили.
  @@index([tenantId, clientId, startsAt])
}

// ---------------------------------------------------------------------------
// Абонементы клиента
// ---------------------------------------------------------------------------

/// Тариф абонемента, который продаёт клуб (напр. «Первая подача»,
/// «Повышаем обороты»). У каждого клуба свой набор тарифов и цен.
///
/// Покрытие услуг задаётся ссылками на конкретные типы услуг этого клуба, а
/// не набором фиксированных категорий. Прежний вариант (enum со значениями
/// вида KIDS_TRAINING / GROUP_TRAINING) был ошибкой проектирования: он
/// намертво зашивал в код услуги «Енисея», и клуб с другим набором типов
/// тренировок настроить абонемент уже не смог бы. Заодно категория «турниры»
/// была слишком грубой — абонемент «Первая подача» покрывает не турниры
/// вообще, а именно «Клуб 50».
model SubscriptionPlan {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String
  visitsCount  Int? // сколько визитов покрывает тариф; null = безлимит
  // Срок в днях, до конца местного дня последнего из них; null = бессрочно
  // (детский абонемент «Енисея»). Так же, как визиты: null — «без предела»,
  // а не магический ноль. Безлимит без срока запрещён CHECK'ом.
  durationDays Int?
  price        Int // копейки

  // Покрывает ли тариф аренду стола. Отдельным флагом, а не связью: столы —
  // не типизированная услуга, аренда либо входит, либо нет.
  coversTableRental Boolean @default(false)

  // Правило тарифа «Повышаем обороты»: аренда стола входит только в
  // безлимитные варианты этого тарифа, не в лимитированные по визитам.
  tableRentalUnlimitedOnly Boolean @default(false)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coveredTrainingTypes   SubscriptionPlanTrainingType[]
  coveredTournamentTypes SubscriptionPlanTournamentType[]
  subscriptions          Subscription[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

/// Какие типы тренировок покрывает тариф абонемента.
/// Для «Енисея»: «Детский абонемент» → «Детская тренировка»;
/// «Первая подача» → «Первая подача»; «Повышаем обороты» → «Общая групповая».
model SubscriptionPlanTrainingType {
  planId         String
  trainingTypeId String
  tenantId       String

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trainingType TrainingType     @relation(fields: [trainingTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([planId, trainingTypeId])
  @@index([tenantId])
}

/// Какие типы турниров покрывает тариф абонемента.
/// Для «Енисея»: «Первая подача» → «Клуб 50» (именно этот тип, а не турниры
/// вообще); «Повышаем обороты» → все типы турниров клуба.
model SubscriptionPlanTournamentType {
  planId           String
  tournamentTypeId String
  tenantId         String

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan           SubscriptionPlan @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tournamentType TournamentType   @relation(fields: [tournamentTypeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([planId, tournamentTypeId])
  @@index([tenantId])
}

/// Купленный клиентом абонемент конкретного тарифа.
///
/// remainingVisits — это КЭШ, а не источник правды: настоящая история
/// движений лежит в SubscriptionLedger. Любое изменение баланса обязано в
/// одной транзакции писать строку в леджер и обновлять это поле, иначе
/// спор «у меня было 10 визитов» разрешить нечем и починить данные после
/// бага невозможно.
model Subscription {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientId String
  client   ClientProfile    @relation(fields: [clientId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: Restrict)

  remainingVisits Int? // текущий остаток визитов; null = безлимит
  purchasedAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime? @db.Timestamptz(3) // null = бессрочно

  /// Цена на момент продажи, копейки. Снимок, как priceAtBooking у записи:
  /// поднятый завтра прайс не переписывает то, за что клиент уже заплатил.
  priceAtPurchase Int

  /// Кто продал у стойки. Продажа — это деньги, прошедшие мимо системы, и
  /// «кто принял 49 000 ₽» должно иметь ответ. У онлайн-покупки автора нет,
  /// зато есть платёж: CHECK требует одно из двух.
  issuedByUserId String?
  issuedBy       TenantMembership? @relation("SubscriptionSeller", fields: [issuedByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  /// Зал продажи. По его поясу посчитан срок — «до конца последнего дня» у
  /// залов в разных регионах наступает в разное время, — и в его же деньгах
  /// дня продажа показана на смене. У клуба с одним залом подставляется он
  /// сам, спрашивать не о чем.
  soldAtHallId String?
  soldAtHall   Hall?   @relation("SubscriptionSale", fields: [soldAtHallId, tenantId], references: [id, tenantId], onDelete: Restrict)

  // Платёж за покупку самого абонемента. Раньше эти деньги в схеме оседать
  // было негде: клиент платил 49 000 ₽, а следа не оставалось.
  paymentId String?  @unique
  payment   Payment? @relation("SubscriptionPurchase", fields: [paymentId], references: [id], onDelete: Restrict)

  ledger                  SubscriptionLedger[]
  trainingBookings        TrainingBooking[]
  tournamentRegistrations TournamentRegistration[]

  @@unique([id, tenantId])
  // Мишень составного ключа записи: запись оплачивается абонементом ЕЁ ЖЕ
  // клиента. Без клиента в ключе родитель, записывая ребёнка, мог бы
  // заплатить своим абонементом — и база бы это приняла.
  @@unique([id, clientId, tenantId])
  @@index([tenantId, clientId])
}

/// Журнал движений визитов по абонементу — единственный источник правды по
/// балансу. Только вставки, без изменений и удалений: баланс на любой момент
/// восстанавливается суммой delta.
model SubscriptionLedger {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  delta        Int // +N при покупке/возврате, -N при списании
  balanceAfter Int? // остаток после операции; null для безлимитных абонементов
  reason       LedgerReason

  // За какой визит движение — настоящие связи вместо прежней безымянной
  // пары sourceType/sourceId. Все три пусты у начисления при покупке
  // абонемента, у ручной корректировки и у сгорания остатка по сроку.
  trainingBookingId String?
  trainingBooking   TrainingBooking? @relation(fields: [trainingBookingId, tenantId], references: [id, tenantId], onDelete: Restrict)

  tournamentRegistrationId String?
  tournamentRegistration   TournamentRegistration? @relation(fields: [tournamentRegistrationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  tableBookingId String?
  tableBooking   TableBooking? @relation(fields: [tableBookingId, tenantId], references: [id, tenantId], onDelete: Restrict)

  // Кто инициировал: продавец при покупке, администратор при корректировке.
  // У движений по записи пусто — их вызывает сама запись.
  createdByUserId String?
  createdBy       TenantMembership? @relation("SubscriptionLedgerAuthor", fields: [createdByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  /// Причина ручной корректировки — обязательна у неё (CHECK).
  note String?

  createdAt DateTime @default(now())

  @@index([tenantId, subscriptionId])
  @@index([trainingBookingId])
  @@index([tournamentRegistrationId])
}

// ---------------------------------------------------------------------------
// Платежи
// ---------------------------------------------------------------------------

/// Один платёж (холд/списание/возврат) за услугу или за покупку абонемента.
///
/// Связь с тем, что оплачено, — не жёсткая внешняя связь, а опциональная 1:1
/// с каждой стороны: в Prisma нет полиморфных связей, поэтому у
/// TrainingBooking, TournamentRegistration, TableBooking, VisitLog и
/// Subscription свой необязательный paymentId, и для конкретного платежа
/// заполнен ровно один из них.
model Payment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // null — для наличной оплаты первого визита ещё не зарегистрированного
  // клиента «с порога» (клиента в системе на момент оплаты просто нет).
  clientId String?
  client   ClientProfile? @relation(fields: [clientId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  purpose PaymentPurpose @default(SERVICE)
  method  PaymentMethod
  status  PaymentStatus

  holdAmount     Int? // сумма, поставленная на холд при записи, копейки
  capturedAmount Int? // фактически списанная сумма (0/50/100% от holdAmount), копейки

  // id платежа в ЮKassa. Уникален — это второй рубеж защиты от повторной
  // обработки одного и того же платежа (первый — таблица WebhookEvent).
  externalId String? @unique

  savedPaymentMethodId String? // каким сохранённым способом оплаты списано (копия на момент платежа)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Обратные связи 1:1 — что именно оплачено этим платежом.
  trainingBooking        TrainingBooking?
  tournamentRegistration TournamentRegistration?
  tableBooking           TableBooking?
  visitLog               VisitLog?
  subscriptionPurchase   Subscription?           @relation("SubscriptionPurchase")

  @@index([tenantId])
}

/// Журнал входящих вебхуков платёжного провайдера — защита от повторной
/// обработки. ЮKassa переотправляет уведомление, пока не получит 200, и без
/// этой таблицы ретрай означал бы повторное списание или повторное
/// начисление визитов.
///
/// Первичный ключ — id события у провайдера, поэтому повторная вставка
/// падает на уникальности, а обработчик понимает, что событие уже принято.
/// processedAt заполняется после успешной обработки: событие принято, но не
/// обработано — это видимое состояние, а не потерянный платёж.
model WebhookEvent {
  id          String    @id // id события у провайдера, не наш cuid
  provider    String    @default("yookassa")
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([processedAt])
}

// ---------------------------------------------------------------------------
// Посещения и уведомления
// ---------------------------------------------------------------------------

/// Факт присутствия/неявки клиента. Помимо статусов на самих бронях, это
/// отдельный журнал для статистики тренера и для визитов, которые не
/// привязаны ни к какой онлайн-брони (флоу «с порога», ручная сверка истории
/// клиента задним числом).
model VisitLog {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientId String
  client   ClientProfile @relation(fields: [clientId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  coachId  String?
  coach    CoachProfile? @relation(fields: [coachId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  sourceType VisitSourceType

  // Откуда визит. Раньше здесь была одна строка sourceId без внешнего ключа
  // — и база не могла отличить настоящую ссылку от опечатки или от брони,
  // удалённой в другом клубе. Теперь три отдельные необязательные связи:
  // у TRAINING, TOURNAMENT и TABLE заполнена ровно своя, у WALK_IN — ни одной
  // (визит с порога и визит, внесённый администратором задним числом при
  // сверке истории, — один инструмент, ТЗ → «Отметка присутствия»).
  // Согласованность с sourceType и запрет «двух источников сразу» проверяет
  // check-констрейнт, см. constraints.sql.
  trainingBookingId String?
  trainingBooking   TrainingBooking? @relation(fields: [trainingBookingId, tenantId], references: [id, tenantId], onDelete: Restrict)

  tournamentRegistrationId String?
  tournamentRegistration   TournamentRegistration? @relation(fields: [tournamentRegistrationId, tenantId], references: [id, tenantId], onDelete: Restrict)

  tableBookingId String?
  tableBooking   TableBooking? @relation(fields: [tableBookingId, tenantId], references: [id, tenantId], onDelete: Restrict)

  paymentId String?  @unique // опциональная привязка к историческому платежу (напр. наличные «с порога»)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  attended Boolean

  /// Когда был визит — начало записи или время, названное администратором
  /// для визита с порога. Не путать с `recordedAt`: вчерашнее занятие
  /// отмечают сегодня, и история клиента по моменту отметки поехала бы на
  /// день.
  visitedAt DateTime @db.Timestamptz(3)

  /// Комментарий администратора к визиту с порога: «пришёл с другом»,
  /// «оплатил наличными».
  note String?

  // Кто из admin/owner отметил присутствие. Настоящая связь, а не просто
  // строка: за этой отметкой стоит списание денег, и она должна указывать на
  // реально существующего пользователя того же клуба.
  //
  // Пусто только у неявки, зафиксированной джобой: у неё нет автора-человека.
  // Это проверяет check-констрейнт (раздел 17 constraints.sql) — присутствие
  // и визит с порога без автора база не примет.
  recordedByUserId String?
  recordedBy       TenantMembership? @relation("VisitRecordedBy", fields: [recordedByUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)
  recordedAt       DateTime          @default(now())

  // Одна запись — один визит: частичные уникальные индексы по каждой ссылке,
  // см. раздел 17 constraints.sql.
  @@index([tenantId, clientId])
  @@index([tenantId, coachId])
  // «Визиты клуба за день» — лента «Отмечено в этот день» на экране смены.
  @@index([tenantId, visitedAt])
}

// ---------------------------------------------------------------------------
// Сессии входа
// ---------------------------------------------------------------------------

/// Выданный refresh-токен. Access-токен живёт минуты и хранится только у
/// клиента, а refresh живёт долго — и без этой таблицы его нельзя отозвать:
/// «выйти на всех устройствах», отобрать доступ у уволенного тренера или
/// погасить украденный токен было бы нечем.
///
/// Хранится ХЭШ токена, а не сам токен. Утечка дампа базы не должна давать
/// возможность войти под чужой учёткой — по той же причине, по которой
/// рядом лежит passwordHash, а не пароль.
/// Клуба у сессии нет: вход — действие платформенное, и один и тот же токен
/// обслуживает человека во всех его клубах. Раньше здесь был tenantId, и он
/// означал бы, что смена клуба требует нового входа.
model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)

  // Отзыв вместо удаления: строка нужна, чтобы отличить «токен погашен» от
  // «токена никогда не было» и заметить попытку переиспользования.
  revokedAt DateTime?

  // Обстоятельства выдачи — для списка активных сессий в личном кабинете.
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Аудит денежных действий
// ---------------------------------------------------------------------------

/// Append-only журнал действий, за которыми стоят деньги, права или
/// персональные данные. Только вставки: строки никогда не изменяются и не
/// удаляются, иначе журнал не имеет доказательной силы. Держит это триггер
/// `AuditLog_append_only` (раздел 17 constraints.sql), а не дисциплина кода.
///
/// Зачем: администратор отмечает неявку — и у клиента списывается 100%.
/// Клиент через неделю приходит с «я был на тренировке». Без журнала
/// предъявить нечего: в брони лежит только текущий статус, без следа, кто и
/// когда его поставил и что было до. Каждое денежное действие обязано
/// писать сюда строку в той же транзакции, что и само изменение.
model AuditLog {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  action AuditAction

  // Автор действия. actorUserId пуст, когда действовал не человек: джоба
  // автонеявки или вебхук ЮKassa. Тип автора хранится отдельно, чтобы
  // «система» не выглядела как потерянная ссылка.
  actorType   ActorType         @default(USER)
  actorUserId String?
  actor       TenantMembership? @relation("AuditActor", fields: [actorUserId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  // На что подействовали: имя модели и её id. Полиморфная пара, как в
  // VisitLog, — жёсткой связи нет, потому что целей больше десятка.
  entityType String
  entityId   String

  // Состояние до и после — то, без чего запись «изменено» бесполезна.
  // Хранить только изменившиеся поля, а не всю сущность целиком.
  before Json?
  after  Json?

  // Причина, если действие ручное и требует объяснения: ручная
  // корректировка баланса, отмена неявки по просьбе клиента.
  reason String?

  ipAddress String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId])
}

// ---------------------------------------------------------------------------
// Юридические документы и согласия
// ---------------------------------------------------------------------------

/// Версия юридического документа: оферта клуба, согласие на обработку
/// персданных, согласие на рекуррентные списания.
///
/// Версионирование здесь — не бюрократия. Доказать, что клиент согласился
/// на удержание денег, можно только предъявив ТОТ текст, который он видел в
/// момент согласия. Документ правится раз в год — значит нужны обе версии и
/// точное знание, кто на какой подписался. Поэтому строки неизменяемы:
/// новая редакция — это новая строка, а не UPDATE существующей.
///
/// tenantId пуст у документов самой платформы (политика обработки ПДн),
/// заполнен у документов конкретного клуба (оферта на услуги).
model LegalDocument {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  type    LegalDocumentType
  version String // человекочитаемая версия, напр. «2026-08-21» или «1.2»

  // Где лежит текст и его контрольная сумма. Хэш нужен, чтобы доказать, что
  // опубликованный документ не подменили задним числом.
  url         String
  contentHash String

  publishedAt DateTime
  createdAt   DateTime @default(now())

  acceptances LegalAcceptance[]

  @@unique([tenantId, type, version])
  @@index([tenantId, type])
}

/// Факт принятия конкретной версии документа конкретным человеком.
///
/// Это и есть недостающее звено из ТЗ: «схема заморозки денег требует
/// юридического документа». Сам документ — задача юриста, но без этой
/// таблицы он бесполезен: удержание обосновано только тогда, когда доказано
/// согласие конкретного клиента с конкретной редакцией.
model LegalAcceptance {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId     String
  membership TenantMembership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Restrict)

  documentId String
  document   LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  acceptedAt DateTime @default(now())

  // Обстоятельства акцепта — обычные доказательства в спорах.
  ipAddress String?
  userAgent String?

  // Отзыв согласия. Не удаление строки: факт, что согласие было и когда его
  // отозвали, сам по себе юридически значим.
  revokedAt DateTime?

  @@unique([userId, documentId])
  @@index([tenantId, userId])
}

/// Уведомление пользователю по одному из каналов (Telegram-бот, Web Push),
/// включая служебные эскалации по неотмеченному присутствию.
model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  membership TenantMembership @relation(fields: [userId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  channel NotificationChannel
  type    NotificationType
  payload Json? // произвольные данные под конкретный тип уведомления

  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId])
}
