{
  // Конфиг сборки: nest build берёт именно его. От основного отличается тем,
  // что действительно пишет dist и не тянет в сборку тесты.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
